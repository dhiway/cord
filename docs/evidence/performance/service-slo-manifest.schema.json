{
  "$id": "https://cord.network/schemas/service-slo-manifest-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "status",
    "network",
    "campaign",
    "E",
    "Q",
    "C",
    "ratification"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "status": {
      "const": "proposed-unratified"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aura_slot_ms",
        "orbis_collators",
        "orbis_cores",
        "origin_validators",
        "para_id",
        "relay_parent_offset",
        "target_block_rate",
        "unincluded_segment_capacity"
      ],
      "properties": {
        "aura_slot_ms": {
          "const": 6000
        },
        "orbis_collators": {
          "const": 2
        },
        "orbis_cores": {
          "const": [
            1,
            3
          ]
        },
        "origin_validators": {
          "const": 6
        },
        "para_id": {
          "const": 1006
        },
        "relay_parent_offset": {
          "const": 1
        },
        "target_block_rate": {
          "const": 3
        },
        "unincluded_segment_capacity": {
          "const": 12
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cooldown_seconds",
        "interleaved_runs",
        "max_clock_offset_ms",
        "max_cv_percent",
        "max_finality_lag_blocks",
        "measurement_seconds",
        "seed",
        "warmup_seconds"
      ],
      "properties": {
        "cooldown_seconds": {
          "const": 300,
          "type": "integer"
        },
        "interleaved_runs": {
          "minimum": 5,
          "type": "integer"
        },
        "max_clock_offset_ms": {
          "minimum": 0,
          "maximum": 50,
          "type": "integer"
        },
        "max_cv_percent": {
          "minimum": 0,
          "maximum": 10,
          "type": "integer"
        },
        "max_finality_lag_blocks": {
          "minimum": 0,
          "maximum": 15,
          "type": "integer"
        },
        "measurement_seconds": {
          "minimum": 1800,
          "type": "integer"
        },
        "seed": {
          "const": 20260713
        },
        "warmup_seconds": {
          "minimum": 600,
          "type": "integer"
        }
      }
    },
    "E": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mix_percent",
        "observed_resource_utilization_max_percent",
        "p95_finality_ms",
        "p95_inclusion_ms",
        "p95_resource_utilization_max_percent",
        "sponsored_intent_success_percent",
        "storage_headroom_min_percent",
        "target_finalized_successful_extrinsics_per_second"
      ],
      "properties": {
        "mix_percent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assets",
            "attestation",
            "names",
            "identity_personhood",
            "sponsored_meta_tx",
            "storage"
          ],
          "properties": {
            "assets": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "attestation": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "names": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "identity_personhood": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "sponsored_meta_tx": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "storage": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "minimum": 0,
          "maximum": 100
        },
        "observed_resource_utilization_max_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "p95_finality_ms": {
          "type": "number",
          "minimum": 0
        },
        "p95_inclusion_ms": {
          "type": "number",
          "minimum": 0
        },
        "p95_resource_utilization_max_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "sponsored_intent_success_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "storage_headroom_min_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "target_finalized_successful_extrinsics_per_second": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "Q": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finalized_hash_required",
        "mix_percent",
        "reconnect_catchup_p95_ms",
        "request_p95_ms",
        "request_success_percent",
        "subscription_completeness_percent",
        "subscription_delivery_p95_ms"
      ],
      "properties": {
        "finalized_hash_required": {
          "type": "boolean"
        },
        "mix_percent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assets",
            "attestation",
            "names",
            "identity_personhood",
            "storage",
            "subscriptions",
            "system"
          ],
          "properties": {
            "assets": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "attestation": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "names": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "identity_personhood": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "storage": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "subscriptions": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "system": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "minimum": 0,
          "maximum": 100
        },
        "reconnect_catchup_p95_ms": {
          "type": "number",
          "minimum": 0
        },
        "request_p95_ms": {
          "type": "number",
          "minimum": 0
        },
        "request_success_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "subscription_completeness_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "subscription_delivery_p95_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "C": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cid_integrity_percent",
        "completion_p95_ms",
        "concurrency",
        "content_buckets",
        "failover_success_percent",
        "mix_percent",
        "network",
        "provider_count",
        "provider_topology",
        "request_rate_per_second",
        "retries",
        "success_percent",
        "throughput_floor_mib_per_second",
        "timeout_ms",
        "ttfb_p95_ms"
      ],
      "properties": {
        "cid_integrity_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "completion_p95_ms": {
          "type": "number",
          "minimum": 0
        },
        "concurrency": {
          "type": "number",
          "minimum": 0
        },
        "content_buckets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "proportion_percent",
              "range"
            ],
            "properties": {
              "proportion_percent": {
                "type": "number",
                "minimum": 0
              },
              "range": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "failover_success_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "mix_percent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "failover",
            "multi_chunk",
            "small_single_block"
          ],
          "properties": {
            "failover": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "multi_chunk": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "small_single_block": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "minimum": 0,
          "maximum": 100
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bandwidth_mbps",
            "latency_ms",
            "loss_percent"
          ],
          "properties": {
            "bandwidth_mbps": {
              "type": "number",
              "minimum": 0
            },
            "latency_ms": {
              "type": "number",
              "minimum": 0
            },
            "loss_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "provider_count": {
          "type": "number",
          "minimum": 0
        },
        "provider_topology": {
          "type": "string",
          "minLength": 1
        },
        "request_rate_per_second": {
          "type": "number",
          "minimum": 0
        },
        "retries": {
          "type": "number",
          "minimum": 0
        },
        "success_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "throughput_floor_mib_per_second": {
          "type": "number",
          "minimum": 0
        },
        "timeout_ms": {
          "type": "number",
          "minimum": 0
        },
        "ttfb_p95_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ratification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_envelope",
        "payload_sha256",
        "sdk_freeze_status",
        "production_activation_status"
      ],
      "properties": {
        "canonical_envelope": {
          "const": "docs/evidence/verification/p5/sdk-freeze-ratification-envelope.json"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$"
        },
        "production_activation_status": {
          "enum": [
            "BLOCKED",
            "READY"
          ]
        },
        "sdk_freeze_status": {
          "enum": [
            "PENDING",
            "RATIFIED"
          ]
        }
      }
    }
  }
}
