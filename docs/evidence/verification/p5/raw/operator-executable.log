      --provider <PROVIDER>
          Provider AccountId32 as 0x-prefixed hex
      --public-endpoint <PUBLIC_ENDPOINT>
          Public provider HTTP endpoint recorded on Orbis
      --data-path <DATA_PATH>
          Filesystem root for blobs and the crash-safe index
      --capacity-bytes <CAPACITY_BYTES>
          Local storage capacity. Must match the operator-approved provider record
      --listen <LISTEN>
          HTTP listener [default: 127.0.0.1:8080]
      --region <REGION>
          Optional provider region label
      --bearer-token-env <BEARER_TOKEN_ENV>
          Environment variable containing the bearer token. The token is never persisted [default: ORBIS_PROVIDER_BEARER_TOKEN]
      --service-key-env <SERVICE_KEY_ENV>
          Environment variable containing the sr25519 secret URI for the registered service key [default: ORBIS_PROVIDER_SERVICE_SURI]
      --max-content-bytes <MAX_CONTENT_BYTES>
          Maximum decoded content bytes per commit [default: 16777216]
      --checkpoint-seconds <CHECKPOINT_SECONDS>
          Signed checkpoint interval in seconds [default: 60]
  -h, --help
