{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cord.network/schemas/scale-metadata-binding-v1.schema.json",
  "title": "OriginCommonsScaleMetadataBindingV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime", "metadata_sha256", "portable_registry_sha256", "logical_types_spec_sha256", "logical_types", "complete", "binding_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "runtime": {"const": "origin-commons-runtime"},
    "metadata_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "portable_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "logical_types_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "logical_types": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["logical_name", "type_path", "portable_id", "shape_sha256"],
        "properties": {
          "logical_name": {"type": "string"},
          "type_path": {"type": "string"},
          "portable_id": {"type": "integer", "minimum": 0},
          "shape_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "complete": {"const": true},
    "binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
