  "interpretations": {
    "fallback_promotion_and_publication": {
      "authority_only_promotion": "After grace, the deterministic eligible replica alone may call promote_checkpoint_fallback using its active finalized Ed25519 service key over the promotion-v1 digest.",
      "separate_transition": true,
      "promotion_writes": [
        "Promoted Providers record only when an effective pending service key activates",
        "ServiceKeyOwner removal of the predecessor key only when pending service-key activation succeeds; the pending key owner was reserved at rotation",
        "ServiceKeyRotated event only when pending service-key activation succeeds",
        "bucket primary/replica roles and monotonic bucket version",
        "every BucketAgreements-referenced Agreement whose capacity_state is not Released: primary/replica roles and monotonic agreement version",
        "AgreementProviderRebound event for each rebound unreleased agreement",
        "DutyAdmissionBlock and shared DutyAdmissionCount reservation for this block",
        "CheckpointDutyCurrent only when an older finalized pending duty is advanced",
        "strict-next-finalized CheckpointDutyPending in PromotionPending mode",
        "exact CheckpointFallbackPromotionReceiptByBucket receipt",
        "ReplicaSelected event",
        "PrimaryPromoted event",
        "CheckpointFallbackPromotionPendingQuorum event"
      ],
      "promotion_must_not_write": [
        "CheckpointClaims",
        "BucketSnapshots",
        "ReplicaCheckpoint"
      ],
      "exact_replay": "The exact accepted promotion receipt is idempotent and emits no event.",
      "publish_quorum": "Exactly the current primary signature plus exactly two distinct eligible current replicas in canonical encoded-provider order.",
      "missing_quorum_submit": "Returns StorageCheckpointInsufficientQuorum/code 239 with zero state and event effects.",
      "one_primary_two_replicas": "At grace the deterministic replica may promote separately, but publication remains pending until the predecessor repairs and validly confirms or governed replacement yields two eligible confirming replicas.",
      "one_primary_three_or_four_replicas": "A direct full-quorum grace submit remains allowed and may atomically promote and publish when two eligible post-promotion confirmations are supplied.",
      "predecessor": "promotion_predecessor is audit-only. It is not an exclusion and may repair/reconnect and confirm if finalized on-chain validation succeeds.",
      "strict_next_snapshot": "The PromotionPending duty has scheduled_at equal to the promotion finalized snapshot and is visible only when scheduled_at < requested_snapshot_checkpoint.",
      "runtime_api_blocked_scope": "BlockedInsufficientFallbackQuorum describes only finalized on-chain eligibility in a visible PromotionPending duty. A provider that is offline but still Active/eligible on chain is optimistically counted by the API; off-chain confirmation collection may nevertheless fail and submit returns code 239.",
      "rollback": "Every listed write/event, including conditional service-key activation and shared admission, is inside the dispatch transaction and rolls back on any later invariant failure.",
      "promotion_write_set_classification": "normative-and-exhaustive-for-success-paths",
      "promotion_preserves_without_write": [
        "BucketAgreements and ProviderAgreements indexes (the primary promotion swaps roles inside the same provider set)",
        "provider pending_bytes and allocated_bytes",
        "ReplicaCheckpoint entries"
      ]
    },
    "shared_admission": {
      "classification": "frozen-interpretation-of-storage-bounds-v1.max_duties_per_block",
      "max_duties_per_block": 256,
      "consumers": [
        "checkpoint-duty admission",
        "challenge admission"
      ],
      "law": "The two consumers reserve from one block-number-scoped counter; any mix may consume slots 1..256 and the 257th combined admission fails with its operation-specific error and zero effects.",
      "operation_errors": {
        "checkpoint": "CheckpointDutyLimit",
        "challenge": "ChallengeDutyLimit"
      },
      "not_admission_capacity": {
        "challenge_backlog": 256,
        "capacity_releases_per_block": 256
      },
      "reconciliation_records_per_tick": 128
    }
  },
