{
  "name": "HostOutboxV1",
  "version": 1,
  "authority": "host-provider-protocol-v2.md#durable-pre-send-outbox",
  "states": ["Prepared", "SentAdvisory", "ResponseInstalled", "AckConfirmed", "Expired", "Quarantined", "GC"],
  "transitions": [
    {"from":"Prepared","event":"network_send","to":"SentAdvisory","guard":"durable_commit_confirmed","effect":"none"},
    {"from":"Prepared","event":"authenticated_response","to":"ResponseInstalled","guard":"response_matches_fingerprint","effect":"atomic_install_response_successor_cursor"},
    {"from":"SentAdvisory","event":"authenticated_response","to":"ResponseInstalled","guard":"response_matches_fingerprint","effect":"atomic_install_response_successor_cursor"},
    {"from":"SentAdvisory","event":"transport_loss","to":"Prepared","guard":"before_recover_until","effect":"resend_byte_identical_record"},
    {"from":"ResponseInstalled","event":"provider_ack_confirmed","to":"AckConfirmed","guard":"ack_hash_matches","effect":"persist_ack_and_retire_consumed_authority"},
    {"from":"AckConfirmed","event":"gc","to":"GC","guard":"durable_successor_or_terminal_and_ttl_satisfied","effect":"erase_body_keep_bounded_tombstone"},
    {"from":"Prepared","event":"recovery_window_closed","to":"Expired","guard":"at_or_after_recover_until","effect":"erase_authority_keep_tombstone"},
    {"from":"ResponseInstalled","event":"recovery_window_closed","to":"Expired","guard":"at_or_after_recover_until","effect":"erase_authority_keep_tombstone"},
    {"from":"Prepared","event":"integrity_failure","to":"Quarantined","guard":"always","effect":"send_nothing_require_user_recovery"},
    {"from":"ResponseInstalled","event":"integrity_failure","to":"Quarantined","guard":"always","effect":"send_nothing_require_user_recovery"}
  ]
}
