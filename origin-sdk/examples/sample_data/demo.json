{
  "entity": {
    "display": "CORD showcase for {label}",
    "web": "https://{label}.cord.dev/demo",
    "email": "ops@{label}.cord.dev",
    "attributes": [
      { "key": "hero", "type": "raw", "template": "Hello from {label}!" },
      { "key": "published", "type": "bool", "value": true },
      { "key": "score", "type": "u64", "value": 4242 },
      { "key": "supply", "type": "u128", "value": "1000000000000" },
      { "key": "fingerprint", "type": "hash", "template": "hash::{label}" },
      { "key": "controller", "type": "token", "source": "account" },
      { "key": "cid", "type": "cid", "template": "ipfs://demo/{label}" },
      { "key": "notes", "type": "none" }
    ]
  },
  "registry": {
    "info": "CORD registry for {label}",
    "kind": "raw",
    "attribute_schema": [
      {"key": "record_id", "type": "raw"},
      {"key": "controller", "type": "token"},
      {"key": "payload_hash", "type": "hash"},
      {"key": "payload_salt", "type": "raw"},
      {"key": "expires_at", "type": "u64", "optional": true},
      {"key": "notes", "type": "raw", "optional": true}
    ],
    "token_spec": {"type": "combo", "keys": ["record_id", "controller"]},
    "lookup_specs": [
      {"type": "combo", "keys": ["record_id", "controller"]},
      {"type": "single", "key": "payload_hash"},
      {"type": "single", "key": "payload_salt"}
    ]
  },
  "packet": {
    "attributes": [
      {
        "key": "record_id",
        "value": {"type": "raw", "template": "{label}-packet"}
      },
      {
        "key": "payload_hash",
        "value": {"type": "hash", "template": "payload::{label}"}
      },
      {
        "key": "controller",
        "value": {"type": "token", "source": "entity"}
      },
      {
        "key": "payload_salt",
        "value": {"type": "salt", "template": "{label}"}
      },
      {
        "key": "expires_at",
        "value": {"type": "u64", "value": 1893456000}
      },
      {
        "key": "notes",
        "value": {"type": "none"}
      }
    ]
  }
}
