{
  "name": "@cord-network/origin-sdk-errors",
  "version": "0.1.0",
  "description": "Stable structural errors for the CORD Origin SDK",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@cord-network/origin-sdk-result": "0.1.0"
  }
}
